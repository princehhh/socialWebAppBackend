# Backend local environment (copy as .env)
NODE_ENV=development
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret_123456
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialvoice
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/socialvoice

VOICE_ACTIVE_TARGET=LIVEKIT_PRIMARY
DB_ACTIVE_TARGET=NEON_PRIMARY

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=

ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

MOCK_PAYMENT_AUTO_SUCCESS=true
EXPOSE_INTERNAL_ERRORS=false
ENABLE_DB_DIAGNOSTICS=false
DB_DIAGNOSTIC_KEY=
